rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        // Keep this list in sync with ADMIN_EMAILS in scripts/firebase-config.js
        && request.auth.token.email in [
             'blessingfobs@gmail.com'
           ];
    }

    // Public uploads bucket: anyone can view (so customers see style photos),
    // only admins can write or delete, and only images <= 10 MB are accepted.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
