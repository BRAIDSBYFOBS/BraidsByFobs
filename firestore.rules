rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        // Keep this list in sync with ADMIN_EMAILS in scripts/firebase-config.js
        && request.auth.token.email in [
             'blessingfobs@gmail.com'
           ];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- styles: world-readable, admin-write ----
    match /styles/{styleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- availability overrides: world-read so the calendar can compute slots ----
    match /availability/{dateKey} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- site content (homepage copy, hero image, contact info) ----
    match /site/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- inventory: admin-only ----
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // ---- expenses: admin-only ----
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ---- bookings ----
    // Anyone can create a booking (guest or signed-in). Without Stripe, bookings
    // are created as confirmed with payment due at the appointment.
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if
        (
          (request.resource.data.status == 'pending'
            && request.resource.data.paymentStatus == 'unpaid')
          || (request.resource.data.status == 'confirmed'
            && request.resource.data.paymentStatus == 'due_at_appointment')
        )
        && (request.resource.data.userId == null
            || (isSignedIn() && request.resource.data.userId == request.auth.uid));

      // Users can cancel their own pending bookings; admins can do anything.
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && request.resource.data.status == 'cancelled'
            && resource.data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ---- user profiles ----
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
